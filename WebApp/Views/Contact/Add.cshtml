@using WebApp.Migrations
@model ContactModel

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
}

<h2 xmlns="http://www.w3.org/1999/html">Dodaj kontakt</h2>
<form asp-action="Add" method="post">
    <div class=mb-3>
        <label class="form-label" asp-for="FirstName"> </label>
        <input class="form-control" asp-for="FirstName"/>
        <span class="text-danger" asp-validation-for="FirstName"></span>
    </div>
    <div class=mb-3>
        <label class="form-label" asp-for="LastName"> </label>
        <input class="form-control" asp-for="LastName"/>
        <span class="text-danger" asp-validation-for="LastName"></span>
    </div>
    <div class=mb-3>
        <label class="form-label" asp-for="Email"> </label>
        <input class="form-control" asp-for="Email"/>
        <span class="text-danger" asp-validation-for="Email"></span>
    </div>
    <div class=mb-3>
        <label class="form-label" asp-for="PhoneNumber"> </label>
        <input class="form-control" asp-for="PhoneNumber"/>
        <span class="text-danger" asp-validation-for="PhoneNumber"></span>
    </div>
    <div class=mb-3>
        <label class="form-label" asp-for="Birth"> </label>
        <input class="form-control" asp-for="Birth"/>
        <span class="text-danger" asp-validation-for="Birth"></span>
    </div>
    <div class=mb-3>
        <label class="form-label" asp-for="Category"> </label>
        <select class="form-control" asp-for="Category"
                asp-items="@Html.GetEnumSelectList<Category>()">
        </select>
        <span class="text-danger" asp-validation-for="Category"></span>
    </div>
    <div class=mb-3>
        <label class="form-label" asp-for="OrganizationId"> </label>
        <select class="form-control" asp-for="OrganizationId"
                asp-items="@Model.Organizations">
        </select>
        <span class="text-danger" asp-validation-for="OrganizationId"></span>
    </div>
    
    <button type="submit" class="btn btn-primary"> Dodaj</button>
</form>
